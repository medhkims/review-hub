rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Authenticated users can read and write their own files
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public read access for profile pictures
    match /profile_pictures/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Post images - authenticated users can read, only owner can write
    match /posts/{postId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Chat attachments - only conversation participants can access
    match /chat/{conversationId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Business images - any authenticated user can read, owner can write
    match /business_images/{businessId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Banner images - public read, admin write (enforced at app level)
    match /banner_images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Banners storage path (used by BannerRemoteDataSource)
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Category default images - public read, admin write (enforced at app level)
    match /category_defaults/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Category logo images - public read, admin write (enforced at app level)
    match /category_images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Review images - public read, authenticated owner can write
    match /review_images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
